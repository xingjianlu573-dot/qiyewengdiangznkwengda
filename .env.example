# ============================================================
# Enterprise Document Intelligence Assistant 配置示例
# 复制为 .env 后按需修改。密钥只放这里，禁止提交到代码库。
# ============================================================

# ---------- 数据目录 ----------
# DATA_DIR=data
# KB_DIR=data/knowledge_base
# INDEX_PATH=data/vector_index.json

# ---------- 解析 / 切片 ----------
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100

# ---------- 向量化 ----------
# provider 二选一：
#   local —— 内置离线向量，无需密钥即可运行（演示 / 内网离线）
#   api   —— OpenAI 兼容 Embedding 接口（企业正式环境推荐）
EMBEDDING_PROVIDER=local

# api 模式下填写（任选一家 OpenAI 兼容网关，如 SiliconFlow / DashScope / OpenAI）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxxxxxx
# EMBEDDING_MODEL=BAAI/bge-m3
# LOCAL_EMBED_DIM=512

# ---------- 检索 ----------
# TOP_K=4              # 返回给 LLM 的片段数
# MIN_SCORE=0.24      # 相似度阈值：低于该值的片段不进答案（防幻觉核心）
# HYBRID_WEIGHT_VECTOR=0.6
# HYBRID_WEIGHT_LEXICAL=0.4

# ---------- LLM ----------
# provider 二选一：
#   offline —— 内置引用模板作答，无需密钥（演示模式）
#   api     —— OpenAI 兼容 Chat 接口（企业正式环境推荐，回答更自然）
LLM_PROVIDER=offline

# api 模式下填写
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=60

# ---------- 服务 ----------
# HOST=0.0.0.0
# PORT=8000
# MAX_UPLOAD_MB=30
