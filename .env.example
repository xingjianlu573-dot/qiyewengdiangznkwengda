# ============================================================
# Enterprise Document Intelligence Assistant 配置示例（全量）
# 使用方法：复制本文件为 .env，按需修改后启动。
# 密钥只放 .env，禁止提交到代码库（.env 已被 .gitignore 忽略）。
# ============================================================

# ============================================================
# AI Provider 抽象层（国产模型适配核心，一键切换）
# ============================================================
# 取值：
#   offline     —— 免密钥演示模式（默认）：内置引用模板作答 + 离线向量
#   openai      —— OpenAI（海外，国内访问需代理，仅作兼容保留）
#   qwen        —— 通义千问（阿里云百炼，国内直连）
#   zhipu       —— 智谱AI（GLM，国内直连）
#   deepseek    —— DeepSeek（国内直连；无 Embedding，自动回退离线向量）
#   moonshot    —— 月之暗面 Kimi（国内直连；无 Embedding，自动回退离线向量）
#   siliconflow —— SiliconFlow 硅基流动（国内直连，聚合开源模型 + BGE 向量）
MODEL_PROVIDER=offline

# 说明：仅设置 MODEL_PROVIDER + LLM_API_KEY 即可工作，网关地址与模型名
# 已内置默认值（见 app/config.py PROVIDER_DEFAULTS），无需手工填写。

# 大模型 API Key（对应上面选择的厂商）
# LLM_API_KEY=sk-xxxxxxxx

# 可选覆盖：不设置时使用对应 Provider 的默认网关与模型
# LLM_BASE_URL=
# LLM_MODEL=

# ---------- Embedding（向量化）----------
# 显式二选一（推荐留空，让系统按 Provider 能力自动推断）：
#   local —— 内置离线哈希向量（免密钥；DeepSeek / 月之暗面等无 Embedding 的 Provider 自动使用）
#   api   —— 调用 Provider 的 Embedding 接口（qwen / zhipu / siliconflow / openai 已内置默认模型）
# EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=sk-xxxxxxxx
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# LOCAL_EMBED_DIM=512

# ---------- 旧配置兼容（可选）----------
# 未设置 MODEL_PROVIDER 时，以下变量沿用旧语义：
#   LLM_PROVIDER=offline | api
# LLM_PROVIDER=offline

# ============================================================
# 解析 / 切片
# ============================================================
# CHUNK_SIZE=600        # 每片最大字符数
# CHUNK_OVERLAP=100     # 片间重叠，保持上下文连贯

# ============================================================
# 检索（防幻觉相关）
# ============================================================
# TOP_K=4               # 返回给 LLM 的片段数
# MIN_SCORE=0.24        # 相似度阈值：低于该值的片段不进答案（防幻觉核心）
# HYBRID_WEIGHT_VECTOR=0.6   # 语义分权重
# HYBRID_WEIGHT_LEXICAL=0.4  # 词法分权重

# ============================================================
# 重排序 Rerank（主流 RAG 架构：检索→重排→生成）
# ============================================================
# RERANK_MODE=offline   # offline=免密钥精排（默认）| llm=大模型重排（需 LLM_API_KEY）| none=关闭
# RERANK_CANDIDATES=8   # 一阶段粗排召回候选数（默认 TOP_K*2=8），重排后取 TOP_K 给 LLM

# ============================================================
# LLM 参数
# ============================================================
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=60

# ============================================================
# 服务与数据目录
# ============================================================
# HOST=0.0.0.0
# PORT=8000
# MAX_UPLOAD_MB=30
# DATA_DIR=data
# KB_DIR=data/knowledge_base
# INDEX_PATH=data/vector_index.json

# ============================================================
# 常见配置示例
# ============================================================
# 示例1：通义千问（Embedding 用阿里云 text-embedding-v3）
#   MODEL_PROVIDER=qwen
#   LLM_API_KEY=sk-xxxx
#
# 示例2：智谱AI GLM-4-Flash（免费额度，适合演示）
#   MODEL_PROVIDER=zhipu
#   LLM_API_KEY=xxxx.xxxx
#
# 示例3：DeepSeek（Embedding 自动回退本地离线向量）
#   MODEL_PROVIDER=deepseek
#   LLM_API_KEY=sk-xxxx
#
# 示例4：月之暗面 Kimi
#   MODEL_PROVIDER=moonshot
#   LLM_API_KEY=sk-xxxx
#
# 示例5：SiliconFlow 开源模型聚合（Embedding 用 BAAI/bge-m3）
#   MODEL_PROVIDER=siliconflow
#   LLM_API_KEY=sk-xxxx
#
# 示例6：OpenAI（海外网关，国内需代理）
#   MODEL_PROVIDER=openai
#   LLM_API_KEY=sk-xxxx
